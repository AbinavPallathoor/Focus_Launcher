<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FocusLauncher" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <!-- No slide/fade when apps open in front of us or when we're surfaced again
             returning to the task's front — this should feel like the persistent OS
             shell, not like a window opening and closing. -->
        <item name="android:windowAnimationStyle">@style/NoWindowAnimation</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="NoWindowAnimation" parent="@android:style/Animation">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
        <item name="android:taskOpenEnterAnimation">@null</item>
        <item name="android:taskOpenExitAnimation">@null</item>
        <item name="android:taskCloseEnterAnimation">@null</item>
        <item name="android:taskCloseExitAnimation">@null</item>
        <item name="android:taskToFrontEnterAnimation">@null</item>
        <item name="android:taskToFrontExitAnimation">@null</item>
        <item name="android:taskToBackEnterAnimation">@null</item>
        <item name="android:taskToBackExitAnimation">@null</item>
    </style>
</resources>
