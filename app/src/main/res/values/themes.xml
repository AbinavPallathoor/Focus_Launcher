<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FocusLauncher" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <!-- No slide/fade when apps open in front of us or when we're surfaced again
             returning to the task's front — this should feel like the persistent OS
             shell, not like a window opening and closing. -->
        <item name="android:windowAnimationStyle">@style/NoWindowAnimation</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <!-- @null here (instead of a real, near-zero-duration animation) is a known source of a
         frozen-frame bug on some Android versions: the outgoing window's surface never gets
         flipped away until some other event forces a redraw — which looks exactly like "back
         doesn't return to the home screen instantly" even though the task switch already
         happened underneath. @anim/no_animation still triggers a proper surface swap. -->
    <style name="NoWindowAnimation" parent="@android:style/Animation">
        <item name="android:activityOpenEnterAnimation">@anim/no_animation</item>
        <item name="android:activityOpenExitAnimation">@anim/no_animation</item>
        <item name="android:activityCloseEnterAnimation">@anim/no_animation</item>
        <item name="android:activityCloseExitAnimation">@anim/no_animation</item>
        <item name="android:taskOpenEnterAnimation">@anim/no_animation</item>
        <item name="android:taskOpenExitAnimation">@anim/no_animation</item>
        <item name="android:taskCloseEnterAnimation">@anim/no_animation</item>
        <item name="android:taskCloseExitAnimation">@anim/no_animation</item>
        <item name="android:taskToFrontEnterAnimation">@anim/no_animation</item>
        <item name="android:taskToFrontExitAnimation">@anim/no_animation</item>
        <item name="android:taskToBackEnterAnimation">@anim/no_animation</item>
        <item name="android:taskToBackExitAnimation">@anim/no_animation</item>
    </style>
</resources>
