# Constrains the classifier model to emit only valid, schema-exact JSON — a single flat
# object, no follow-up questions. Every transaction gets tagged immediately; the user corrects
# a wrong guess afterward with a free-text note rather than being asked anything up front.
root ::= "{" ws "\"kind\":" ws kind "," ws "\"category\":" ws category "," ws "\"isPerson\":" ws bool "," ws "\"confidence\":" ws confidence ws "}"

kind ::= "\"EXPENSE\"" | "\"LENT\"" | "\"BORROWED\"" | "\"REPAYMENT_IN\"" | "\"REPAYMENT_OUT\"" | "\"INCOME\""
category ::= "\"FOOD\"" | "\"TRANSPORT\"" | "\"ESSENTIALS\"" | "\"EXTRAS\"" | "\"SUBSCRIPTION\"" | "null"
bool ::= "true" | "false"

confidence ::= [01] "." [0-9] [0-9]?

ws ::= [ \t\n]*
